    "capture": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "retrievalStatus": {
                "enum": [
                  "ok",
                  "partial"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "payloadHash": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "rawPayloadRef": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "payloadHash",
              "rawPayloadRef"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "retrievalStatus": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "payloadHash": {
                "type": "null"
              },
              "rawPayloadRef": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "retrievalStatus": {
                "const": "not_modified"
              }
            }
          },
          "then": {
            "properties": {
              "payloadHash": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "rawPayloadRef": {
                "minLength": 1,
                "type": "string"
              }
            }
          }
        }
      ],
